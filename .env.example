APP_NAME=secure-healthcare-api
APP_ENV=development
APP_DEBUG=false
AUTH_MODE=wso2_backend_jwt

DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/healthcare

JWT_ISSUER=https://localhost:9443/oauth2/token
JWT_AUDIENCE=secure-healthcare-api
JWKS_URL=https://localhost:9443/oauth2/jwks

# Signed assertion generated by WSO2 after OAuth and scope validation.
WSO2_BACKEND_JWT_HEADER=X-JWT-Assertion
WSO2_BACKEND_JWT_ISSUER=wso2.org/products/am
WSO2_BACKEND_JWT_AUDIENCE=
WSO2_BACKEND_JWT_JWKS_URL=https://host.docker.internal:8243/jwks
WSO2_BACKEND_JWT_PUBLIC_KEY_PATH=/run/wso2/backend-signing.crt
WSO2_BACKEND_JWT_ALGORITHMS=RS256
WSO2_SUBJECT_CLAIM=sub
WSO2_SCOPE_CLAIM=scope
WSO2_ROLE_CLAIM=roles
TRUSTED_GATEWAY_HOSTS=172.18.0.1
ALLOW_DIRECT_ACCESS=false

ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
