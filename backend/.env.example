APP_NAME=secure-healthcare-api
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=false
AUTH_MODE=direct_jwt
DATABASE_URL=postgresql+psycopg://healthcare_app:change_me@localhost:5432/healthcare
JWT_ISSUER=https://localhost:9443/oauth2/token
JWT_AUDIENCE=secure-healthcare-api
JWKS_URL=https://localhost:9443/oauth2/jwks
JWT_ALGORITHMS=RS256
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ACCESS_TOKEN_LEEWAY_SECONDS=30

WSO2_BACKEND_JWT_HEADER=X-JWT-Assertion
WSO2_BACKEND_JWT_ISSUER=https://localhost:9443/oauth2/token
WSO2_BACKEND_JWT_AUDIENCE=secure-healthcare-api
WSO2_BACKEND_JWT_JWKS_URL=https://localhost:9443/oauth2/jwks
WSO2_BACKEND_JWT_ALGORITHMS=RS256
WSO2_BACKEND_JWT_LEEWAY_SECONDS=30
WSO2_SUBJECT_CLAIM=sub
WSO2_SCOPE_CLAIM=scope
WSO2_ROLE_CLAIM=roles
TRUSTED_GATEWAY_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
ALLOW_DIRECT_ACCESS=false
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
MAX_REQUEST_BODY_BYTES=1048576

